<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. Copy to ~/Library/LaunchAgents/ and replace __REPO_DIR__ with the
  absolute path of this checkout:

      sed "s|__REPO_DIR__|$(cd "$(dirname "$0")/.." && pwd)|g" \
        scripts/<this-file> > ~/Library/LaunchAgents/<label>.plist

  launchd has no relative-path option, so the substitution is unavoidable. It is
  a placeholder rather than a real path on purpose: the previous version carried
  one developer's absolute path, which kept working right up until the checkout
  moved and then failed silently.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dreamrecorder.dayone-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO_DIR__/scripts/dayone_worker.py</string>
    <string>sync-cloud-pending</string>
    <string>--relay-url</string>
    <string>https://replace-with-worker-url</string>
    <string>--mac-token</string>
    <string>replace-with-mac-worker-token</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/dream-recorder-dayone-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dream-recorder-dayone-sync.err</string>
</dict>
</plist>
