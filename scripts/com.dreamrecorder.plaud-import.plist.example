<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. Copy to ~/Library/LaunchAgents/ and replace __REPO_DIR__ with the
  absolute path of this checkout:

      sed "s|__REPO_DIR__|$(cd "$(dirname "$0")/.." && pwd)|g" \
        scripts/<this-file> > ~/Library/LaunchAgents/<label>.plist

  launchd has no relative-path option, so the substitution is unavoidable. It is
  a placeholder rather than a real path on purpose: the previous version carried
  one developer's absolute path, which kept working right up until the checkout
  moved and then failed silently.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dreamrecorder.plaud-import</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO_DIR__/scripts/run_plaud_importer.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/dream-recorder-plaud-import.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/dream-recorder-plaud-import.err</string>
</dict>
</plist>
